    },
    {
      "@type": "DataCatalog",
      "name": "FAO Harmonized World Soil Database v1.2",
      "url": "https://data.apps.fao.org/catalog/iso/2427214a-42dc-4862-b58a-00b73cbc7a6f",
      "description": "Global 30 arc-second soil data including clay CEC for expansive soil screening"
    },
    {
      "@type": "ScholarlyArticle",
      "name": "Global Outlook for Climate-Driven Soil Shrink-Swell Subsidence",
      "url": "https://www.researchsquare.com/article/rs-9955921/v1",
      "datePublished": "2026",
      "description": "250 m resolution global model calibrated on French insurance data; poleward risk expansion"
    },
    {
      "@type": "ScholarlyArticle",
      "name": "Global Distribution of Clay-Size Minerals (Ito & Wagai 2017)",
      "url": "https://www.nature.com/articles/sdata2017103",
