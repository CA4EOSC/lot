{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "100 Links on Shrink-Swell Risks Data",
  "description": "A curated collection of 100 links covering shrink-swell (expansive clay soil) risk data, including national datasets, research papers, regulatory resources, GIS portals, satellite monitoring tools, and climate projections. Covers UK (BGS GeoSure/GeoClimate), France (BRGM/G\u00e9orisques), USA (USGS/NRCS), Australia, and global sources.",
  "keywords": [
    "shrink-swell",
    "expansive clay soil",
    "subsidence",
    "geohazard",
    "clay mineralogy",
    "soil risk",
    "InSAR",
    "soil moisture",
    "climate change",
    "building damage",
    "retrait-gonflement",
    "GeoSure",
    "BRGM",
    "BGS",
    "USGS"
  ],
  "dateCreated": "2026-08-10",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "creator": {
    "@type": "Person",
    "name": "Claude (Anthropic)"
  },
  "hasPart": [
    {
      "@type": "DataCatalog",
      "name": "BGS GeoSure Shrink-Swell",
      "url": "https://www.bgs.ac.uk/datasets/bgs-geosure-shrink-swell/",
      "description": "National hazard susceptibility map for Great Britain"
    },
    {
      "@type": "DataCatalog",
      "name": "BGS GeoClimate Shrink-Swell",
      "url": "https://www.bgs.ac.uk/datasets/geoclimate-shrink-swell/",
      "description": "Climate-adjusted shrink-swell hazard projections for Great Britain"
    },
    {
      "@type": "DataCatalog",
      "name": "GeoSure Shrink-Swell Deposits v8 (data.gov.uk)",
      "url": "https://www.data.gov.uk/dataset/cfb275c6-e674-4193-8ed4-b74d60480566/geosure-shrink-swell-deposits-version-8",
      "description": "Open government data release of BGS shrink-swell polygon dataset"
    },
    {
      "@type": "DataCatalog",
      "name": "G\u00e9orisques Retrait-Gonflement des Argiles 2026",
