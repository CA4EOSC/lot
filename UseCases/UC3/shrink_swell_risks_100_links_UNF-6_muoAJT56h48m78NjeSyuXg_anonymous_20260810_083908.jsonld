  "@type": "Dataset",
  "name": "100 Links on Shrink-Swell Risks Data",
  "description": "A curated collection of 100 links covering shrink-swell (expansive clay soil) risks data worldwide, including datasets, research papers, regulatory resources, mapping portals, satellite monitoring tools, and engineering guidance. Topics include BGS GeoSure/GeoClimate (UK), BRGM retrait-gonflement (France), USGS swelling clay maps (USA), global clay mineralogy datasets, InSAR monitoring, FAO/HWSD soil databases, and climate change projections for shrink-swell hazard.",
  "url": "https://github.com/CA4EOSC/consortium/blob/main/UseCases/UC3/shrink_swell_risks_100_links_UNF-6_muoAJT56h48m78NjeSyuXg_anonymous_20260810_083908.md",
  "keywords": [
    "shrink-swell",
    "expansive soils",
    "clay soil hazard",
    "subsidence",
    "geohazard",
    "soil swelling",
    "retrait-gonflement",
    "BGS GeoSure",
    "BRGM",
    "InSAR",
    "soil moisture",
    "climate change",
    "natural hazard",
    "geotechnical data",
    "smectite",
    "linear extensibility"
  ],
