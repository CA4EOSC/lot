  "dateCreated": "2026-08-10",
  "spatialCoverage": {
    "@type": "Place",
    "name": "Global (with focus on UK, France, USA, Australia)"
  },
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "Shrink-swell hazard susceptibility",
      "description": "Potential for clay soils to shrink and swell causing ground movement and structural damage"
    },
    {
      "@type": "PropertyValue",
      "name": "Clay mineralogy",
      "description": "Distribution of smectite, kaolinite, illite and other clay minerals"
    },
    {
      "@type": "PropertyValue",
      "name": "Linear extensibility (COLE)",
      "description": "Coefficient of linear extensibility used as shrink-swell potential metric in US soil surveys"
    },
    {
      "@type": "PropertyValue",
      "name": "Volume change potential (VCP)",
      "description": "BGS metric for potential soil volume change due to moisture content variation"
    },
    {
      "@type": "PropertyValue",
      "name": "Soil Water Index (SWI)",
      "description": "Copernicus-derived soil moisture variable used in shrink-swell risk modelling"
    },
    {
      "@type": "PropertyValue",
      "name": "Insurance subsidence claims",
      "description": "Financial loss data from clay shrink-swell events used for model calibration"
    }
  ],
  "distribution": [
    {
