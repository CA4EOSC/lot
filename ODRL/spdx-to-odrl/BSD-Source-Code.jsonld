        "https://cdif.org/odrl/": "cdif",
        "https://spdx.org/licenses/": "spdx",
        "http://example.com/policy:": "odrl:uid"
    },
    "@type": "odrl:Set",
    "odrl:uid": "http://example.com/policy:bsd-source-code",
