{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "spdx": "https://spdx.org/licenses/",
    "cdif": "https://cdif.org/odrl/",
    "@vocab": "http://www.w3.org/ns/odrl/2/",
    "action": {"@type": "@id"},
    "target": {"@type": "@id"},
    "profile": {"@type": "@id"}
  },
  "@type": "Offer",
  "uid": "https://cdif.org/odrl/policy/docbook-dtd-license",
  "profile": "https://cdif.org/odrl:profile:DocBook-DTD",
  "assigner": "https://cdif.org/party/all-copyright-holders",
  "permission": [
    {
      "@type": "Rule",
      "target": "spdx:DocBook-DTD",
      "action": "odrl:use",
      "assignee": "https://cdif.org/party/all-users",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "@type": "Rule",
      "target": "spdx:DocBook-DTD",
      "action": "odrl:copy",
      "assignee": "https://cdif.org/party/all-users",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "@type": "Rule",
      "target": "spdx:DocBook-DTD",
      "action": "odrl:modify",
      "assignee": "https://cdif.org/party/all-users",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "@type": "Rule",
      "target": "spdx:DocBook-DTD",
      "action": "odrl:distribute",
      "assignee": "https://cdif.org/party/all-users",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "@type": "Rule",
      "action": "cdif:includeNotice",
      "target": "spdx:DocBook-DTD",
      "assigner": "https://cdif.org/party/all-users",
      "assignee": "https://cdif.org/party/all-users",
      "constraint": [
        {
          "leftOperand": "cdif:scope",
          "operator": "odrl:eq",
          "rightOperand": "cdif:copiesOrSubstantialPortions"
        }
      ]
    }
  ],
  "description": "Permission to use, copy, modify and distribute the DocBook XML DTD and its accompanying documentation for any purpose and without fee is hereby granted in perpetuity, provided that the above copyright notice and this paragraph appear in all copies."
}