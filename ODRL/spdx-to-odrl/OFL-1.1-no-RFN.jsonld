{
    "@context": {
        "http://www.w3.org/ns/odrl/2/": "odrl",
        "https://cdif.org/odrl/": "cdif",
        "https://spdx.org/licenses/": "spdx",
        "http://www.w3.org/2000/01/rdf-schema#": "rdfs",
        "http://www.w3.org/2001/XMLSchema#": "xsd",
        "http://www.w3.org/2200/01/rdf-schema#": "owl",
        "http://purl.org/dc/terms/": "dc"
    },
    "@type": "odrl:Policy",
    "uid": "https://cdif.org/odrl/policy/OFL-1.1-no-RFN",
    "profile": "https://cdif.org/odrl:profile:OFL-1.1-no-RFN",
    "target": "spdx:OFL-1.1-no-RFN.html",
    "description": "Open Font License Version 1.1, granting rights for use, study, copy, merge, embed, modify, redistribute, and sell modified/unmodified font software.",
    "permission": [
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:use",
            "odrl:target": "spdx:OFL-1.1-no-RFN.html",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:study",
            "odrl:target": "spdx:OFL-1.1-no-RFN.html",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:copy",
            "odrl:target": "spdx:OFL-1.1-no-RFN.html",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "cdif:merge",
            "odrl:target": "spdx:OFL-1.1-no-RFN.html",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                },
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:noReservedNameUse",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:ne",
                            "odrl:rightOperand": "cdif:reservedFontName"
                        }
                    ],
                    "odrl:target": []
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:embed",
            "odrl:target": "spdx:OFL-1.1-no-RFN.html",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:modify",
            "odrl:target": "spdx:OFL-1.1-no-RFN.html",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                },
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:noReservedNameUse",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:primaryFontName"
                        }
                    ],
                    "odrl:target": []
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:redistribute",
            "odrl:target": "spdx:OFL-1.1-no-RFN.html",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:sell",
            "odrl:target": "spdx:OFL-1.1-no-RFN.html",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:noStandaloneSale",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:standaloneItem"
                        }
                    ],
                    "odrl:target": []
                }
            ]
        }
    ]
}