{
    "@context": {
        "odrl": "http://www.w3.org/ns/odrl/2/",
        "cdif": "https://cdif.org/odrl/",
        "spdx": "https://spdx.org/licenses/",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },
    "@type": "Policy",
    "uid": "https://cdif.org/odrl/policy/Borceux1993",
    "profile": "https://cdif.org/odrl:profile:Borceux",
    "permission": [
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:use",
            "odrl:assigner": "http://example.com/party/FrancisBorceux",
            "odrl:target": "spdx:Borceux.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:modify",
            "odrl:assigner": "http://example.com/party/FrancisBorceux",
            "odrl:target": "spdx:Borceux.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:action": "odrl:distribute",
            "odrl:assigner": "http://example.com/party/FrancisBorceux",
            "odrl:target": "spdx:Borceux.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        }
    ]
}