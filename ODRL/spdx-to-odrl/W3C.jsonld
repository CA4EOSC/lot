            }
          ],
          "target": [
            "cdif:noticeOfChanges",
            "cdif:preExistingDisclaimers"
          ]
        }
      ]
    },
    {
      "target": "spdx:W3C.software",
      "action": "odrl:distribute",
      "assigner": "http://www.w3.org/",
      "assignee": "http://www.w3.org/licensee",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
