{
    "@context": {
        "http://www.w3.org/ns/odrl/2/": "odrl",
        "https://cdif.org/odrl/": "cdif",
        "http://purl.org/dc/terms/": "dc",
        "http://www.w3.org/2000/01/rdf-schema#": "rdfs",
        "http://www.w3.org/2001/XMLSchema#": "xsd",
        "https://spdx.org/licenses/": "spdx"
    },
    "@type": "odrl:Set",
    "odrl:uid": "https://cdif.org/odrl/policy/OPL-UK-3.0",
    "odrl:profile": "https://cdif.org/odrl:profile:OPL-UK-3.0",
    "odrl:target": "spdx:OPL-UK-3.0.html",
    "odrl:permission": [
        {
            "odrl:action": "odrl:copy",
            "odrl:target": "spdx:OPL-UK-3.0.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "odrl:action": "odrl:publish",
            "odrl:target": "spdx:OPL-UK-3.0.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "odrl:action": "odrl:distribute",
            "odrl:target": "spdx:OPL-UK-3.0.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "odrl:action": "odrl:modify",
            "odrl:target": "spdx:OPL-UK-3.0.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "odrl:action": "odrl:use",
            "odrl:target": "spdx:OPL-UK-3.0.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "odrl:action": "odrl:sublicense",
            "odrl:target": "spdx:OPL-UK-3.0.html",
            "odrl:duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        }
    ]
}