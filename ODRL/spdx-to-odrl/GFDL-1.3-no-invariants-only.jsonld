{
    "@context": {
        "http://www.w3.org/ns/odrl.jsonld": "odrl",
        "https://cdif.org/odrl/": "cdif",
        "https://spdx.org/licenses/": "spdx",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },
    "@type": "Policy",
    "uid": "http://example.com/policy:GFDL-1.3-no-invariants-only",
    "profile": "https://cdif.org/odrl:profile:GFDL-1.3-no-invariants-only",
    "target": "spdx:GFDL-1.3-no-invariants-only.html",
    "assigner": "http://fsf.org/",
    "assignee": "http://www.w3.org/ns/odrl/2/Person",
    "permission": [
        {
            "target": "spdx:GFDL-1.3-no-invariants-only.html",
            "assigner": "http://fsf.org/",
            "assignee": "http://www.w3.org/ns/odrl/2/Person",
            "action": "odrl:copy",
            "duty": [
                {
                    "action": "cdif:retainNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:noticeType",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:licenseNotice"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        },
        {
            "target": "spdx:GFDL-1.3-no-invariants-only.html",
            "assigner": "http://fsf.org/",
            "assignee": "http://www.w3.org/ns/odrl/2/Person",
            "action": "odrl:distribute",
            "duty": [
                {
                    "action": "cdif:retainNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:noticeType",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:licenseNotice"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        },
        {
            "target": "spdx:GFDL-1.3-no-invariants-only.html",
            "assigner": "http://fsf.org/",
            "assignee": "http://www.w3.org/ns/odrl/2/Person",
            "action": "odrl:modify",
            "duty": [
                {
                    "action": "cdif:preserveStructure",
                    "constraint": [
                        {
                            "leftOperand": "cdif:sectionType",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:invariantSection"
                        }
                    ],
                    "target": [
                        "cdif:invariantSection",
                        "cdif:historySection",
                        "cdif:acknowledgementsSection",
                        "cdif:dedicationsSection"
                    ]
                },
                {
                    "action": "cdif:retainNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:noticeType",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:licenseNotice"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        },
        {
            "target": "spdx:GFDL-1.3-no-invariants-only.html",
            "assigner": "http://fsf.org/",
            "assignee": "http://www.w3.org/ns/odrl/2/Person",
            "action": "cdif:merge",
            "duty": [
                {
                    "action": "cdif:combineDocuments",
                    "constraint": [
                        {
                            "leftOperand": "cdif:sourceDocumentCount",
                            "operator": "odrl:gt",
                            "rightOperand": {
                                "@value": "1",
                                "@type": "xsd:integer"
                            }
                        }
                    ],
                    "target": [
                        "cdif:allInvariantSections",
                        "cdif:allHistorySections",
                        "cdif:allAcknowledgementsSections",
                        "cdif:allDedicationsSections"
                    ]
                }
            ]
        },
        {
            "target": "spdx:GFDL-1.3-no-invariants-only.html",
            "assigner": "http://fsf.org/",
            "assignee": "http://www.w3.org/ns/odrl/2/Person",
            "action": "cdif:translate",
            "duty": [
                {
                    "action": "cdif:includeOriginal",
                    "constraint": [
                        {
                            "leftOperand": "cdif:languageMatch",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:originalEnglish"
                        }
                    ],
                    "target": [
                        "cdif:originalLicenseText"
                    ]
                }
            ]
        }
    ],
    "prohibition": [
        {
            "target": "spdx:GFDL-1.3-no-invariants-only.html",
            "assigner": "http://fsf.org/",
            "assignee": "http://www.w3.org/ns/odrl/2/Person",
            "action": "odrl:prohibit",
            "remedy": [
                {
                    "action": "cdif:voidPolicy",
                    "target": "spdx:GFDL-1.3-no-invariants-only.html"
                }
            ],
            "duty": [
                {
                    "action": "cdif:retainNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:noticeType",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:licenseNotice"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:licenseNotice"
                    ]
                }
            ]
        }
    ]
}