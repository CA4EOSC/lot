{
    "@context": {
        "odrl": "http://www.w3.org/ns/odrl/2/",
        "spdx": "https://spdx.org/licenses/",
        "cdif": "https://cdif.org/odrl/",
        "@vocab": "http://www.w3.org/ns/odrl/2/",
        "action": {"@type": "@id"},
        "target": {"@type": "@id"},
        "profile": {"@type": "@id"}
    },
    "@type": "Policy",
    "id": "https://cdif.org/odrl/policy/dtoa",
    "profile": "https://cdif.org/odrl:profile:dtoa",
    "description": "License granting permission to use, copy, modify, and distribute the software for any purpose without fee, provided the full notice is included.",
    "permission": [
        {
            "target": "spdx:dtoa.html",
            "action": "odrl:use",
            "duty": [{
                "action": "cdif:includeNotice",
                "constraint": [{
                    "leftOperand": "cdif:scope",
                    "operator": "odrl:eq",
                    "rightOperand": "cdif:copiesOrSubstantialPortions"
                }],
                "target": [
                    "cdif:copyrightNotice",
                    "cdif:permissionNotice"
                ]
            }]
        },
        {
            "target": "spdx:dtoa.html",
            "action": "odrl:reproduce",
            "duty": [{
                "action": "cdif:includeNotice",
                "constraint": [{
                    "leftOperand": "cdif:scope",
                    "operator": "odrl:eq",
                    "rightOperand": "cdif:copiesOrSubstantialPortions"
                }],
                "target": [
                    "cdif:copyrightNotice",
                    "cdif:permissionNotice"
                ]
            }]
        },
        {
            "target": "spdx:dtoa.html",
            "action": "odrl:modify",
            "duty": [{
                "action": "cdif:includeNotice",
                "constraint": [{
                    "leftOperand": "cdif:scope",
                    "operator": "odrl:eq",
                    "rightOperand": "cdif:copiesOrSubstantialPortions"
                }],
                "target": [
                    "cdif:copyrightNotice",
                    "cdif:permissionNotice"
                ]
            }]
        },
        {
            "target": "spdx:dtoa.html",
            "action": "odrl:distribute",
            "duty": [{
                "action": "cdif:includeNotice",
                "constraint": [{
                    "leftOperand": "cdif:scope",
                    "operator": "odrl:eq",
                    "rightOperand": "cdif:copiesOrSubstantialPortions"
                }],
                "target": [
                    "cdif:copyrightNotice",
                    "cdif:permissionNotice"
                ]
            }]
        }
    ]
}