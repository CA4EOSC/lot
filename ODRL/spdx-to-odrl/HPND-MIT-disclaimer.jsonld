{
    "@context": {
        "odrl": "http://www.w3.org/ns/odrl/2/",
        "spdx": "https://spdx.org/licenses/",
        "cdif": "https://cdif.org/odrl/",
        "@vocab": "http://www.w3.org/ns/odrl/2/",
        "action": {"@type": "@id"},
        "target": {"@type": "@id"},
        "profile": {"@type": "@id"}
    },
    "@type": "Policy",
    "uid": "http://example.com/policy/hpnd-mit-disclaimer",
    "profile": "https://cdif.org/odrl:profile:HPND-MIT-disclaimer",
    "permission": [
        {
            "target": "spdx:HPND-MIT-disclaimer.html",
            "action": "odrl:use",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "target": "spdx:HPND-MIT-disclaimer.html",
            "action": "odrl:copy",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "target": "spdx:HPND-MIT-disclaimer.html",
            "action": "odrl:modify",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "target": "spdx:HPND-MIT-disclaimer.html",
            "action": "odrl:distribute",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ],
            "constraint": [
                {
                    "leftOperand": "cdif:party",
                    "operator": "odrl:neq",
                    "rightOperand": "cdif:authorNameUsedInAdvertising"
                }
            ]
        }
    ],
    "description": "Permission to use, copy, modify, and distribute this software and its documentation for any purpose and without fee, provided that original copyright notices and this permission notice appear in all copies and supporting documentation."
}