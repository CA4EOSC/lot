                            "rightOperand": "cdif:commercialPurpose"
                        }
                    ]
                }
            ]
        },
        {
            "@type": "Permission",
            "target": "spdx:CC-BY-NC-ND-3.0-DE.html",
            "assigner": "http://example.com/licensor",
            "assignee": "http://example.com/user",
            "action": "odrl:modify",
            "duty": [
                {
                    "action": "cdif:noDerivatives",
                    "constraint": [
                        {
                            "leftOperand": "cdif:modificationLevel",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:none"
                        }
                    ]
                }
            ]
        },
        {
            "@type": "Permission",
            "target": "spdx:CC-BY-NC-ND-3.0-DE.html",
            "assigner": "http://example.com/licensor",
            "assignee": "http://example.com/user",
            "action": "cdif:merge",
            "duty": [
                {
                    "action": "cdif:noDerivatives",
                    "constraint": [
                        {
                            "leftOperand": "cdif:modificationLevel",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:none"
                        }
                    ]
                }
            ]
        },
        {
            "@type": "Permission",
            "target": "spdx:CC-BY-NC-ND-3.0-DE.html",
            "assigner": "http://example.com/licensor",
            "assignee": "http://example.com/user",
            "action": "odrl:distribute",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                },
                {
                    "action": "cdif:enforceNonCommercial",
                    "constraint": [
                        {
                            "leftOperand": "cdif:purpose",
                            "operator": "odrl:neq",
                            "rightOperand": "cdif:commercialPurpose"
                        }
                    ]
                }
            ]
        },
