{
    "@context": {
        "http://www.w3.org/ns/odrl/2/": "odrl",
        "https://cdif.org/odrl/": "cdif",
        "https://spdx.org/licenses/": "spdx",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },
    "@type": "odrl:Policy",
    "odrl:uid": "https://cdif.org/odrl/policy/linux-man-pages-copyleft-2-para",
    "odrl:profile": "https://cdif.org/odrl:profile:Linux-man-pages-copyleft-2-para",
    "permission": [
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:Linux-man-pages-copyleft-2-para.html",
            "odrl:action": "odrl:copy",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:Linux-man-pages-copyleft-2-para.html",
            "odrl:action": "odrl:modify",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:derivedWork",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:identicalTerms"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:Linux-man-pages-copyleft-2-para.html",
            "odrl:action": "odrl:distribute",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        }
    ]
}