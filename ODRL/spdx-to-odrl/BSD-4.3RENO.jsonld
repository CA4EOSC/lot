{
    "@context": {
        "odrl": "http://www.w3.org/ns/odrl/2/",
        "spdx": "https://spdx.org/licenses/",
        "cdif": "https://cdif.org/odrl/",
        "@vocab": "http://www.w3.org/ns/odrl/2/",
        "action": {"@type": "@id"},
        "target": {"@type": "@id"},
        "profile": {"@type": "@id"}
    },
    "@type": "odrl:Set",
    "uid": "http://example.com/policy:BSD-4.3RENO",
    "profile": "https://cdif.org/odrl/profile/BSD-4.3RENO",
    "permission": [
        {
            "target": "spdx:BSD-4.3RENO.html",
            "action": "odrl:use",
            "duty": [{
                "action": "cdif:includeNotice",
                "constraint": [{
                    "leftOperand": "cdif:scope",
                    "operator": "odrl:eq",
                    "rightOperand": "cdif:copiesOrSubstantialPortions"
                }],
                "target": [
                    "cdif:copyrightNotice",
                    "cdif:permissionNotice"
                ]
            }]
        },
        {
            "target": "spdx:BSD-4.3RENO.html",
            "action": "odrl:reproduce",
            "duty": [{
                "action": "cdif:includeNotice",
                "constraint": [{
                    "leftOperand": "cdif:scope",
                    "operator": "odrl:eq",
                    "rightOperand": "cdif:copiesOrSubstantialPortions"
                }],
                "target": [
                    "cdif:copyrightNotice",
                    "cdif:permissionNotice"
                ]
            }]
        },
        {
            "target": "spdx:BSD-4.3RENO.html",
            "action": "odrl:modify",
            "duty": [{
                "action": "cdif:includeNotice",
                "constraint": [{
                    "leftOperand": "cdif:scope",
                    "operator": "odrl:eq",
                    "rightOperand": "cdif:copiesOrSubstantialPortions"
                }],
                "target": [
                    "cdif:copyrightNotice",
                    "cdif:permissionNotice"
                ]
            }]
        },
        {
            "target": "spdx:BSD-4.3RENO.html",
            "action": "odrl:distribute",
            "duty": [{
                "action": "cdif:includeNotice",
                "constraint": [{
                    "leftOperand": "cdif:scope",
                    "operator": "odrl:eq",
                    "rightOperand": "cdif:copiesOrSubstantialPortions"
                }],
                "target": [
                    "cdif:copyrightNotice",
                    "cdif:permissionNotice"
                ]
            }]
        }
    ]
}