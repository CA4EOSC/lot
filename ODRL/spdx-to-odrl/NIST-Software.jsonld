{
    "@context": {
        "http://www.w3.org/ns/odrl/2/": "odrl",
        "https://cdif.org/odrl/": "cdif",
        "https://spdx.org/licenses/": "spdx",
        "http://www.w3.org/2001/XMLSchema#": "xsd",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
    },
    "@type": "odrl:Policy",
    "odrl:uid": "https://cdif.org/odrl/policy/nist-software",
    "odrl:profile": "https://cdif.org/odrl:profile:NIST-Software",
    "odrl:permission": [
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:NIST-Software.html",
            "odrl:action": "odrl:use",
            "odrl:duty": [
                {
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:attributionNotice",
                        "cdif:modificationNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:NIST-Software.html",
            "odrl:action": "odrl:copy",
            "odrl:duty": [
                {
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:NIST-Software.html",
            "odrl:action": "odrl:distribute",
            "odrl:duty": [
                {
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:attributionNotice",
                        "cdif:modificationNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:NIST-Software.html",
            "odrl:action": "odrl:modify",
            "odrl:duty": [
                {
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:attributionNotice",
                        "cdif:modificationNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:NIST-Software.html",
            "odrl:action": "cdif:merge",
            "odrl:duty": [
                {
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:attributionNotice",
                        "cdif:modificationNotice"
                    ]
                }
            ]
        }
    ]
}