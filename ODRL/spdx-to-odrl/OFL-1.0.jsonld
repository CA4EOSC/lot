{
    "@context": {
        "odrl": "http://www.w3.org/ns/odrl/2/",
        "cdif": "https://cdif.org/odrl/",
        "spdx": "https://spdx.org/licenses/",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "odrl:permission": "http://www.w3.org/ns/odrl/2/permission",
        "odrl:duty": "http://www.w3.org/ns/odrl/2/duty",
        "odrl:action": "http://www.w3.org/ns/odrl/2/action",
        "odrl:target": "http://www.w3.org/ns/odrl/2/target",
        "odrl:profile": "http://www.w3.org/ns/odrl/2/profile",
        "odrl:uid": "http://www.w3.org/ns/odrl/2/uid",
        "cdif:includeNotice": "https://cdif.org/odrl/includeNotice",
        "cdif:scope": "https://cdif.org/odrl/scope",
        "cdif:copyOrSubstantialPortions": "https://cdif.org/odrl/copyOrSubstantialPortions",
        "cdif:copyrightNotice": "https://cdif.org/odrl/copyrightNotice",
        "cdif:permissionNotice": "https://cdif.org/odrl/permissionNotice",
        "odrl:eq": "http://www.w3.org/2001/XMLSchema#",
        "odrl:ne": "http://www.w3.org/2001/XMLSchema#",
        "odrl:implies": "http://www.w3.org/ns/odrl/2/implies"
    },
    "@type": "Set",
    "profile": "https://cdif.org/odrl:profile/OFL-1.0",
    "uid": "https://cdif.org/odrl/policy/OFL-1.0",
    "permission": [
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:OFL-1.0.html",
            "odrl:action": "odrl:use",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:OFL-1.0.html",
            "odrl:action": "odrl:copy",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:OFL-1.0.html",
            "odrl:action": "cdif:merge",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:OFL-1.0.html",
            "odrl:action": "odrl:embed",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:OFL-1.0.html",
            "odrl:action": "odrl:modify",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:OFL-1.0.html",
            "odrl:action": "odrl:redistribute",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "odrl:target": "spdx:OFL-1.0.html",
            "odrl:action": "odrl:sell",
            "odrl:duty": [
                {
                    "@type": "odrl:Duty",
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "@type": "odrl:Constraint",
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortions"
                        }
                    ],
                    "odrl:target": [
