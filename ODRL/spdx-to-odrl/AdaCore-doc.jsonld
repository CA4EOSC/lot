{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "spdx": "https://spdx.org/licenses/",
    "cdif": "https://cdif.org/odrl/",
    "@vocab": "http://www.w3.org/ns/odrl/2/",
    "action": {"@type": "@id"},
    "target": {"@type": "@id"},
    "profile": {"@type": "@id"}
  },
  "@type": "Set",
  "uid": "https://cdif.org/odrl/policy/AdaCore-doc",
  "profile": "https://cdif.org/odrl:profile:AdaCore-doc",
  "permission": [
    {
      "target": "spdx:AdaCore-doc.html",
      "action": "odrl:reproduce",
      "assigner": "http://example.com/assigner",
      "assignee": "http://example.com/assignee",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:AdaCore-doc.html",
      "action": "odrl:modify",
      "assigner": "http://example.com/assigner",
      "assignee": "http://example.com/assignee",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ],
      "constraint": [
        {
          "leftOperand": "odrl:alterationMarking",
          "operator": "odrl:eq",
          "rightOperand": "true"
        }
      ]
    },
    {
      "target": "spdx:AdaCore-doc.html",
      "action": "odrl:use",
      "assigner": "http://example.com/assigner",
      "assignee": "http://example.com/assignee",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:AdaCore-doc.html",
      "action": "odrl:distribute",
      "assigner": "http://example.com/assigner",
      "assignee": "http://example.com/assignee",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    }
  ]
}