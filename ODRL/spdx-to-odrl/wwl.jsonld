{
    "@context": {
        "http://www.w3.org/ns/dcat#": "dcat:",
        "http://www.w3.org/ns/odrl/2/": "odrl:",
        "https://cdif.org/odrl/": "cdif:",
        "https://spdx.org/licenses/": "spdx:",
        "http://www.w3.org/2200/0/vocabulary/": "voc:",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },
    "@type": "odrl:Policy",
    "uid": "https://cdif.org/odrl/policy/freebsd-license-policy",
    "profile": "https://cdif.org/odrl:profile:wwl",
    "target": "spdx:FreeBSD_Code",
    "description": "Policy derived from the FreeBSD license text, granting broad rights while prohibiting GPL licensing.",
    "permission": [
        {
            "@type": "odrl:Permission",
            "action": "odrl:use",
            "target": "spdx:FreeBSD_Code",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "action": "odrl:copy",
            "target": "spdx:FreeBSD_Code",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "action": "odrl:modify",
            "target": "spdx:FreeBSD_Code",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "action": "cdif:merge",
            "target": "spdx:FreeBSD_Code",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "action": "odrl:publish",
            "target": "spdx:FreeBSD_Code",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "action": "odrl:distribute",
            "target": "spdx:FreeBSD_Code",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "action": "odrl:sublicense",
            "target": "spdx:FreeBSD_Code",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
        {
            "@type": "odrl:Permission",
            "action": "odrl:sell",
            "target": "spdx:FreeBSD_Code",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        }
    ],
    "prohibition": [
        {
            "@type": "odrl:Prohibition",
            "action": "odrl:license",
            "target": "spdx:FreeBSD_Code",
            "constraint": [
                {
                    "leftOperand": "cdif:licenseType",
                    "operator": "odrl:eq",
                    "rightOperand": "GPL"
                }
            ],
            "description": "The code may not be licensed under any form of the GPL."
        }
    ]
}