    "@type": "odrl:Set",
    "uid": "https://cdif.org/odrl/policy/TOSL-1.0a",
    "profile": "https://cdif.org/odrl:profile:TOSL",
    "target": "spdx:TOSL.html",
    "permission": [
        {
