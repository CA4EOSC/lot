  },
  "@type": "Set",
  "uid": "https://cdif.org/odrl/policy/threeparttable",
  "profile": "https://cdif.org/odrl:profile:threeparttable",
  "permission": [
    {
      "target": "spdx:threeparttable.html",
      "action": "odrl:use",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:threeparttable.html",
      "action": "odrl:copy",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:threeparttable.html",
      "action": "odrl:modify",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:threeparttable.html",
      "action": "cdif:merge",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:threeparttable.html",
      "action": "odrl:distribute",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
