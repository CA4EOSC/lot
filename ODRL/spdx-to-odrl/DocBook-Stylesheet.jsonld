{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "spdx": "https://spdx.org/licenses/",
    "cdif": "https://cdif.org/odrl/",
    "@vocab": "http://www.w3.org/ns/odrl/2/",
    "action": {"@type": "@id"},
    "target": {"@type": "@id"},
    "profile": {"@type": "@id"}
  },
  "@type": "Offer",
  "uid": "https://cdif.org/odrl/policy/docbook-stylesheet-2005",
  "profile": "https://cdif.org/odrl/profile/DocBook-Stylesheet",
  "assigner": {
    "@type": "Party",
    "uid": "http://example.com/party/copyright-holders"
  },
  "permission": [
    {
      "target": "spdx:db4-upgrade.xsl",
      "assigner": "http://example.com/party/copyright-holders",
      "action": "odrl:use",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:db4-upgrade.xsl",
      "assigner": "http://example.com/party/copyright-holders",
      "action": "odrl:copy",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:db4-upgrade.xsl",
      "assigner": "http://example.com/party/copyright-holders",
      "action": "odrl:modify",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    },
    {
      "target": "spdx:db4-upgrade.xsl",
      "assigner": "http://example.com/party/copyright-holders",
      "action": "odrl:distribute",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ]
    }
  ]
}