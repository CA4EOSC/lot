{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "spdx": "https://spdx.org/licenses/",
    "cdif": "https://cdif.org/odrl/",
    "@vocab": "http://www.w3.org/ns/odrl/2/",
    "action": {"@type": "@id"},
    "target": {"@type": "@id"},
    "profile": {"@type": "@id"}
  },
  "@type": "odrl:Set",
  "odrl:uid": "http://example.com/policy:hpnd-sell-variant-critical-systems",
  "profile": "https://cdif.org/odrl:profile:HPND-sell-variant-critical-systems",
  "permission": [
    {
      "target": "spdx:HPND-sell-variant-critical-systems.html",
      "action": [
        "odrl:use",
        "odrl:copy",
        "odrl:modify",
        "odrl:distribute",
        "odrl:sell"
      ],
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ],
          "target": [
            "cdif:copyrightNotice",
            "cdif:permissionNotice"
          ]
        }
      ],
      "constraint": [
        {
          "leftOperand": "cdif:usageContext",
          "operator": "odrl:ne",
          "rightOperand": "cdif:safetyCriticalSystems"
        }
      ]
    }
  ]
}