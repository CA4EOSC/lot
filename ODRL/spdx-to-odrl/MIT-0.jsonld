{
    "@context": {
        "http://www.w3.org/2000/01/rdf-schema#": "rdf",
        "http://www.w3.org/2000/01/XMLSchema#": "xsd",
        "http://www.w3.org/2000/01/rdf-schema#": "rdfs",
