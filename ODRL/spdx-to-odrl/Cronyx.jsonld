{
    "@context": {
        "http://www.w3.org/ns/odrl/2/": "odrl",
        "https://cdif.org/odrl/": "cdif",
        "https://spdx.org/licenses/": "spdx",
        "http://www.w3.org/ns/shacl#": "sh",
        "http://www.w3.org/2001/XMLSchema#": "xsd"
    },
    "@type": "odrl:Policy",
    "odrl:uid": "https://cdif.org/odrl/policy/cronyx-fonts",
    "odrl:profile": "https://cdif.org/odrl:profile:Cronyx",
    "odrl:target": "spdx:Cronyx.html",
    "odrl:permission": [
        {
            "odrl:action": [
                "odrl:use",
                "odrl:copy",
                "odrl:modify",
                "odrl:distribute",
                "odrl:sell",
                "odrl:sublicense",
                "odrl:merge",
                "odrl:publish"
            ],
            "odrl:duty": [
                {
                    "odrl:action": "cdif:includeNotice",
                    "odrl:constraint": [
                        {
                            "odrl:leftOperand": "cdif:scope",
                            "odrl:operator": "odrl:eq",
                            "odrl:rightOperand": "cdif:copyOrSubstantialPortion"
                        }
                    ],
                    "odrl:target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        }
    ]
}