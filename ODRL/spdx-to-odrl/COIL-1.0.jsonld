{
    "@context": {
        "odrl": "http://www.w3.org/ns/odrl/2/",
        "spdx": "https://spdx.org/licenses/",
        "cdif": "https://cdif.org/odrl/",
        "@vocab": "http://www.w3.org/ns/odrl/2/",
        "action": {"@type": "@id"},
        "target": {"@type": "@id"},
        "profile": {"@type": "@id"}
    },
    "@type": "Policy",
    "uid": "http://example.com/policy/coil-1.0",
    "profile": "https://cdif.org/odrl:profile:COIL-1.0",
    "description": "Copyfree Open Innovation License v1.0",
    "permission": [
        {
            "target": "spdx:COIL-1.0.html",
            "assigner": "http://example.com/licensor",
            "assignee": "http://example.com/any-person",
            "action": "odrl:reproduce",
            "duty": [
                {
                    "action": "cdif:includeNotice",
                    "constraint": [
                        {
                            "leftOperand": "cdif:scope",
                            "operator": "odrl:eq",
                            "rightOperand": "cdif:copiesOrSubstantialPortions"
                        }
                    ],
                    "target": [
                        "cdif:copyrightNotice",
                        "cdif:permissionNotice"
                    ]
                }
            ]
        },
