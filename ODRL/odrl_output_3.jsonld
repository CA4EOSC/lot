{
  "@context": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "spdx": "https://spdx.org/licenses/",
    "cdif": "https://cdif.org/odrl/",
    "@vocab": "http://www.w3.org/ns/odrl/2/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
  },
  "@type": "Set",
  "uid": "https://cdif.org/odrl/policy/mit-license",
  "profile": "https://cdif.org/odrl:profile:mit",
  "permission": [
    {
      "target": "spdx:Software",
      "action": "odrl:use",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ]
        }
      ]
    },
    {
      "target": "spdx:Software",
      "action": "odrl:reproduce",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ]
        }
      ]
    },
    {
      "target": "spdx:Software",
      "action": "odrl:modify",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ]
        }
      ]
    },
    {
      "target": "spdx:Software",
      "action": "cdif:merge",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ]
        }
      ]
    },
    {
      "target": "spdx:Software",
      "action": "odrl:publish",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ]
        }
      ]
    },
    {
      "target": "spdx:Software",
      "action": "odrl:distribute",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ]
        }
      ]
    },
    {
      "target": "spdx:Software",
      "action": "odrl:sublicense",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ]
        }
      ]
    },
    {
      "target": "spdx:Software",
      "action": "odrl:sell",
      "duty": [
        {
          "action": "cdif:includeNotice",
          "constraint": [
            {
              "leftOperand": "cdif:scope",
              "operator": "odrl:eq",
              "rightOperand": "cdif:copiesOrSubstantialPortions"
            }
          ]
        }
      ]
    }
  ]
}